# ─── Server ──────────────────────────────────────────────
PORT=3001

# ─── PostgreSQL ───────────────────────────────────────────
# Replace with your actual connection string when hosting
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/teslamart

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_before_deploying
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
